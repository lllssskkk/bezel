cabal-version:      3.0
name:               bezel
version:            0.1.0.0
synopsis:
    projectional editor written in functional reactive programming
license:            MIT
license-file:       LICENSE
author:             lllssskkk
maintainer:         lusikaistudy@gmail.com
category:           Codec
build-type:         Simple
extra-doc-files:    CHANGELOG.md


flag dev
  description: Enable lean development
  default:     False
  manual:      True

common warnings
  ghc-options:
    -Wall -Wcompat -Wincomplete-uni-patterns
    -Wmissing-deriving-strategies -Wredundant-constraints
    -Wmissing-home-modules -Wmissing-export-lists -fwarn-unused-imports

  if !flag(dev)
    ghc-options: -Werror


common shared
    default-language:   GHC2024
    default-extensions: NoImplicitPrelude, OverloadedStrings
    build-depends:
        , base             >=4.20 && <5
        , relude           ^>=1.2
        , Yampa            ^>=0.15
        , text             >=2.0  && <2.2

library
    import:           shared
    import:           warnings
    exposed-modules:
        Editor.Model
        Editor.App
        Editor.Storage
        Editor.View
        Editor.Interaction
        Canvas.Input
        Canvas.Geometry
    hs-source-dirs:   src
    build-depends:

executable bezel
    import:           shared
    import:           warnings
    main-is:          Main.hs
    build-depends:
        bezel
    hs-source-dirs:   app
    default-language: GHC2024
